process_DiD_by_depth,
file.path(
TABLE_DIR,
"08c_process_DiD_by_depth.csv"
),
row.names = FALSE
)
# ------------------------------------------------------------------------------
# 9. Publication-oriented candidate figure
# ------------------------------------------------------------------------------
# Panel A — profile-level timing shift, paired Stable_PP vs TP_to_Crop.
timing_profile_means <- trajectory_metrics |>
group_by(
LandUseTrajectory,
pair_profile_id,
Treatment,
Block
) |>
summarise(
timing_shift =
mean(
timing_shift
),
.groups =
"drop"
) |>
mutate(
LandUseTrajectory = factor(
LandUseTrajectory,
levels = c(
"Stable_PP",
"TP_to_Crop"
),
labels = c(
"Stable PP",
"TP -> Crop"
)
)
)
pA <- ggplot(
timing_profile_means,
aes(
x = LandUseTrajectory,
y = timing_shift,
group = pair_profile_id
)
) +
geom_hline(
yintercept = 0,
linewidth = 0.35,
linetype = 3,
colour = "grey55"
) +
geom_line(
alpha = 0.45,
linewidth = 0.45
) +
geom_point(
aes(
shape = Treatment
),
size = 2.8
) +
labs(
x = NULL,
y = "Taxonomy-function timing shift",
shape = "Warming",
title = "A  Temporal asynchrony occurs in both land-use trajectories",
subtitle = paste0(
"Trajectory difference: exact paired-profile p = ",
formatC(
timing_trajectory_difference$p_exact_two_sided,
format = "f",
digits = 3
)
)
) +
theme_bw() +
theme(
panel.grid.minor =
element_blank(),
panel.grid.major.x =
element_blank()
)
# Panel B — PP-referenced multivariate divergence.
multi_plot <- multivariate_DiD |>
filter(
Interval %in% c(
"2022-2023",
"2023-2024"
)
) |>
mutate(
Interval = factor(
Interval,
levels = c(
"2022-2023",
"2023-2024"
)
),
Domain = factor(
Domain,
levels = c(
"Taxonomy",
"N_function"
),
labels = c(
"Taxonomy",
"N activities"
)
),
label = paste0(
"p = ",
formatC(
p_exact,
format = "f",
digits = 3
)
)
)
pB <- ggplot(
multi_plot,
aes(
x = Interval,
y = vector_norm
)
) +
geom_point(
size = 3
) +
geom_text(
aes(
label = label
),
vjust = -0.7,
size = 3
) +
facet_wrap(
~ Domain,
scales = "free_y"
) +
labs(
x = NULL,
y = "Norm of mean PP-referenced change vector",
title = "B  Divergence from the stable-PP interannual reference",
subtitle = "Scales differ between taxonomic and N-factor spaces; compare intervals within panels"
) +
theme_bw() +
theme(
panel.grid.minor =
element_blank()
)
# Panel C — signed process changes in each trajectory.
process_plot <- process_changes_by_trajectory |>
filter(
Interval %in% c(
"2022-2023",
"2023-2024"
)
) |>
mutate(
LandUseTrajectory = factor(
LandUseTrajectory,
levels = c(
"Stable_PP",
"TP_to_Crop"
),
labels = c(
"Stable PP",
"TP -> Crop"
)
),
Interval = factor(
Interval,
levels = c(
"2022-2023",
"2023-2024"
)
),
Process = factor(
Process,
levels = PROCESS_VARS
)
)
pd <- position_dodge(
width = 0.45
)
pC <- ggplot(
process_plot,
aes(
x = Process,
y = mean_delta,
shape = LandUseTrajectory
)
) +
geom_hline(
yintercept = 0,
linewidth = 0.35,
linetype = 3,
colour = "grey55"
) +
geom_point(
size = 2.6,
position = pd
) +
geom_errorbar(
aes(
ymin =
mean_delta -
se_delta,
ymax =
mean_delta +
se_delta
),
width = 0.08,
linewidth = 0.4,
position = pd
) +
facet_wrap(
~ Interval,
nrow = 1
) +
labs(
x = NULL,
y = expression(
"Mean signed " * Delta * "z"
),
shape = "Trajectory",
title = "C  Potential N-activity changes: shared year response vs land-use divergence"
) +
theme_bw() +
theme(
panel.grid.minor =
element_blank(),
panel.grid.major.x =
element_blank(),
axis.text.x =
element_text(
angle = 25,
hjust = 1
)
)
# Panel D — direct PP-referenced process DiD.
did_plot <- process_DiD_long |>
filter(
Interval %in% c(
"2022-2023",
"2023-2024"
)
) |>
group_by(
Interval,
Process
) |>
summarise(
n = n(),
mean_DiD =
mean(
DiD
),
se_DiD =
sd(
DiD
) /
sqrt(
n
),
.groups =
"drop"
) |>
left_join(
process_DiD_tests |>
filter(
Interval %in% c(
"2022-2023",
"2023-2024"
)
) |>
select(
Interval,
Process,
p_exact_two_sided
),
by = c(
"Interval",
"Process"
)
) |>
mutate(
Process = factor(
Process,
levels = PROCESS_VARS
),
Interval = factor(
Interval,
levels = c(
"2022-2023",
"2023-2024"
)
),
p_label = paste0(
"p=",
formatC(
p_exact_two_sided,
format = "f",
digits = 3
)
)
)
pD <- ggplot(
did_plot,
aes(
x = Process,
y = mean_DiD
)
) +
geom_hline(
yintercept = 0,
linewidth = 0.35,
linetype = 3,
colour = "grey55"
) +
geom_point(
size = 2.7
) +
geom_errorbar(
aes(
ymin =
mean_DiD -
se_DiD,
ymax =
mean_DiD +
se_DiD
),
width = 0.08,
linewidth = 0.4
) +
geom_text(
aes(
label = p_label
),
vjust = -0.8,
size = 2.8
) +
facet_wrap(
~ Interval,
nrow = 1
) +
labs(
x = NULL,
y = expression(
"PP-referenced " * Delta * Delta * "z"
),
title = "D  Process-specific TP -> Crop divergence relative to Stable PP",
subtitle = "Positive = more positive change under TP -> Crop; exact p-values have 1/64 resolution"
) +
theme_bw() +
theme(
panel.grid.minor =
element_blank(),
panel.grid.major.x =
element_blank(),
axis.text.x =
element_text(
angle = 25,
hjust = 1
)
)
if (
requireNamespace(
"patchwork",
quietly = TRUE
)
) {
p_all <- patchwork::wrap_plots(
pA,
pB,
pC,
pD,
ncol = 1,
heights = c(
0.9,
1,
1,
1
),
guides = "collect"
) &
theme(
legend.position = "bottom"
)
ggsave(
file.path(
FIG_DIR,
"08c_PP_reference_landuse_change.pdf"
),
p_all,
width = 9.5,
height = 12,
device = cairo_pdf
)
ggsave(
file.path(
FIG_DIR,
"08c_PP_reference_landuse_change.png"
),
p_all,
width = 9.5,
height = 12,
dpi = 300
)
}
# ------------------------------------------------------------------------------
# 10. Save analysis object
# ------------------------------------------------------------------------------
analysis_08c <- list(
design =
observed_state_map,
interpretation =
"Stable_PP is a contemporary reference for shared interannual variation, not a pure weather control.",
trajectory_metrics =
trajectory_metrics,
timing_by_trajectory =
timing_by_trajectory,
timing_trajectory_difference =
timing_trajectory_difference,
score_changes =
score_changes,
score_DiD =
score_DiD,
multivariate_DiD =
multivariate_DiD,
process_changes =
process_changes,
process_changes_by_trajectory =
process_changes_by_trajectory,
process_DiD =
process_DiD_long,
process_DiD_tests =
process_DiD_tests
)
saveRDS(
analysis_08c,
file.path(
INT_DIR,
"08c_PP_reference_landuse_change.rds"
)
)
# ------------------------------------------------------------------------------
# 11. Console summary
# ------------------------------------------------------------------------------
message(
"Timing shift within each trajectory:"
)
print(
timing_by_trajectory |>
select(
LandUseTrajectory,
mean_timing_shift,
mean_tax_early_fraction,
mean_N_early_fraction,
p_exact_two_sided
)
)
message(
"Difference in timing shift (TP_to_Crop - Stable_PP):"
)
print(
timing_trajectory_difference |>
select(
contrast,
mean_difference,
p_exact_two_sided
)
)
message(
"PP-referenced multivariate divergence:"
)
print(
multivariate_DiD |>
select(
Interval,
Domain,
vector_norm,
p_exact
)
)
message(
"PP-referenced process contrasts:"
)
print(
process_DiD_tests |>
select(
Interval,
Process,
mean_DiD,
p_exact_two_sided,
p_FDR_within_interval
)
)
message(
"Script 08c completed."
)
# ==============================================================================
08c_PP_reference_landuse_change.png
p_all
FIG_DIR
source("scripts/08d_warming_landuse_interaction.R")
source("scripts/09b_temporal_driver_figures.R")
source("scripts/09c_temporal_driver_figures.R")
source("scripts/09d_temporal_driver_figures.R")
source("scripts/09_temporal_driver_figures.R")
